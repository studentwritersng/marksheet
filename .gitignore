# env files (can opt-in for committing if needed)
.env
scripts/
!hub/scripts/
*.zip*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
public/uploads/

# Sentry Config File
.env.sentry-build-plugin

# never commit these
youtube_tutorials/
*.log
importError.txt
local_error.txt
build_error.log
error.log
