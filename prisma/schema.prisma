// Marksheet — Nigerian Secondary School Syllabus & Examination Platform
// Schema covers foundational modules: PRD 01 (School/Session/Term/Class),
// PRD 02 (Staff/Roles/Assignments), PRD 03 (Students/Guardians),
// plus cross-cutting scaffolding: multi-tenancy (school_id), audit log (PRD 11),
// and AI provider config (PRD 14). Later PRDs extend this incrementally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PRD 01: School, Session & Term Management
// ---------------------------------------------------------------------------

model School {
  id                      String           @id @default(cuid())
  name                    String
  address                 String?
  logo                    String?
  signature               String? // principal/rector signature image URL
  stamp                   String? // school stamp image URL
  phone                   String?
  email                   String?
  motto                   String?
  letterheadSettings      Json?
  // Configurable grading scale (e.g. A1-F9 bands). Stored as ordered JSON bands.
  gradingScale            Json?
  // Admission number format template, e.g. "SCH/{year}/{seq:4}"
  admissionFormat         String?
  // Shortcode for auto-generating student IDs, e.g. "TDC" → "TDC00123"
  shortcode               String?          @unique
  // Auto-incrementing counter for student numbers
  studentSequence         Int              @default(0)
  // Maintenance mode — when true, non-admin users see a maintenance page
  maintenanceMode         Boolean          @default(false)
  // Suspended by platform owner — when true, all school users are blocked
  suspended               Boolean          @default(false)
  // Custom white-label domain (Model A). Bare lowercase hostname, unique.
  customDomain         String? @unique
  customDomainVerified Boolean @default(false)
  customDomainToken    String?
  // Per-school SMTP sender (School Email Sender). Credentials encrypted at rest.
  smtpHost      String?                 // e.g. smtp.gmail.com
  smtpPort      Int?                    // e.g. 587
  smtpUser      String?                 // Gmail address / sender login
  smtpPassEnc   String?                 // encrypted app password (AES-256-GCM)
  smtpFrom      String?                 // From address (Gmail: must equal smtpUser)
  smtpSecure    Boolean @default(false) // true => port 465 implicit SSL; false => STARTTLS
  smtpEnabled   Boolean @default(false) // master on/off + "configured" flag
  // Appearance — portal primary colour theme (blue/green/purple/black/gold)
  portalTheme          String  @default("blue")
  // Selected login screen layout (minimalist/illustrative/classic/split/secure/dark)
  loginDesign          String  @default("classic")
  // Custom image for image-based login designs (illustrative/split/secure)
  loginImage           String?
  // Editable login-screen copy (heading/subheading/brandLine/footerText) as JSON
  loginTexts           Json?
  // Fee gating configuration (PRD 12 §3.2)
  feeGateExams            Boolean          @default(false) // block exam access if fee not cleared
  feeGateResults          Boolean          @default(false) // block result release if fee not cleared
  // Attendance period toggle — if false, attendance is once per day (morning sign-in)
  attendancePeriodEnabled Boolean          @default(false)
  // Time after which sign-in is considered late, e.g. "08:30"
  attendanceLateCutoff    String?
  // Pricing stage for this school (Basic / Standard / Premium)
  stage                   LicenseStageName @default(basic)
  // Referral tracking
  referralId              String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  sessions                 Session[]
  subjects                 Subject[]
  staff                    Staff[]
  students                 Student[]
  users                    User[]
  auditLogs                AuditLog[]
  syllabi                  Syllabus[]
  lessonNotes              LessonNote[]
  questions                Question[]
  exams                    Exam[]
  assessmentWeightings     AssessmentWeighting[]
  assessmentTypes          AssessmentType[]
  remarkTemplates          RemarkTemplate[]
  reportCardTemplates      ReportCardTemplate[]
  timetablePeriods         TimetablePeriod[]
  timetableEntries         TimetableEntry[]
  classSubjects            ClassSubject[]
  announcements            Announcement[]
  licenses                 SchoolLicense[]
  payments                 Payment[]
  tickets                  Ticket[]
  consentRecords           ConsentRecord[]
  schoolAddons             SchoolAddon[]
  subjectRequirements      SubjectTimetableRequirement[]
  staffAvailability        StaffAvailability[]
  timetableTemplates       TimetableTemplate[]
  timetableRules           SchoolTimetableRule[]
  addonTimetables          AddonTimetable[]
  timetableWizards         TimetableWizard[]
  taughtTopics             TaughtTopic[]
  attendanceRecords        AttendanceRecord[]
  staffAttendance          StaffAttendanceRecord[]
  idCardTemplate           IDCardTemplate?
  notificationLogs         NotificationLog[]
  notificationQueue        NotificationQueue[]
  schoolNotificationConfig SchoolNotificationConfig?
  groupMembership          GroupMembership?
  referral                 Referral?                     @relation(fields: [referralId], references: [id])
  hubs                     Hub[]
  offlineBundles           OfflineBundle[]

  homeworks           Homework[]

  feeItems            FeeItem[]
  studentPayments     StudentPayment[]
  feeReminderConfig   FeeReminderConfig?

  originTransfers      GroupStudentTransferRecord[] @relation("TransferOriginSchool")
  destinationTransfers GroupStudentTransferRecord[] @relation("TransferDestinationSchool")
  commissions          ReferralCommission[]

  @@map("schools")
}

enum SessionStatus {
  upcoming
  active
  closed
}

model Session {
  id        String        @id @default(cuid())
  schoolId  String
  label     String // e.g. "2025/2026"
  isCurrent Boolean       @default(false)
  status    SessionStatus @default(upcoming)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  terms   Term[]
  classes Class[]

  @@unique([schoolId, label])
  @@index([schoolId])
  @@map("sessions")
}

enum TermName {
  First
  Second
  Third
}

model Term {
  id        String    @id @default(cuid())
  sessionId String
  name      TermName
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session        Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignments    Assignment[]
  lessonNotes    LessonNote[]
  exams          Exam[]
  subjectResults SubjectResult[]
  termResults    TermResult[]
  feeItems       FeeItem[]
  studentPayments StudentPayment[]

  homeworks           Homework[]

  @@unique([sessionId, name])
  @@index([sessionId])
  @@map("terms")
}

model Class {
  id            String   @id @default(cuid())
  schoolId      String
  sessionId     String
  name          String // auto-generated: level + section (e.g. "JSS1" or "JSS1A")
  level         String // JSS1 / JSS2 / JSS3 / SSS1 / SSS2 / SSS3
  section       String   @default("") // optional arm: "A", "B", "C"... "" means single-section
  department    String   @default("") // SSS only: "science" / "art" / "commercial" / ""
  defaultRoomId String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  session               Session                       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  defaultRoom           Room?                         @relation(fields: [defaultRoomId], references: [id])
  assignments           Assignment[]
  students              Student[]
  promotionsFrom        PromotionRecord[]             @relation("PromotionFromClass")
  promotionsTo          PromotionRecord[]             @relation("PromotionToClass")
  lessonNotes           LessonNote[]
  exams                 Exam[]
  examClasses           ExamClass[]
  timetableEntries      TimetableEntry[]
  classSubjects         ClassSubject[]
  subjectRequirements   SubjectTimetableRequirement[]
  addonTimetableEntries AddonTimetableEntry[]
  taughtTopics          TaughtTopic[]
  attendanceRecords     AttendanceRecord[]

  homeworks           Homework[]

  @@unique([sessionId, level, section, department])
  @@index([schoolId])
  @@index([sessionId])
  @@map("classes")
}

model PromotionRecord {
  id            String   @id @default(cuid())
  schoolId      String
  fromClassId   String
  toClassId     String? // null when outcome is withdrawal
  sessionFromId String
  sessionToId   String?
  studentIds    String[] // admission-time snapshot of promoted students
  performedBy   String // Staff id
  performedAt   DateTime @default(now())
  notes         String?

  fromClass Class  @relation("PromotionFromClass", fields: [fromClassId], references: [id])
  toClass   Class? @relation("PromotionToClass", fields: [toClassId], references: [id])

  @@index([schoolId])
  @@index([fromClassId])
  @@map("promotion_records")
}

// ---------------------------------------------------------------------------
// PRD 02: Staff, Roles & Permissions
// ---------------------------------------------------------------------------

model Staff {
  id            String   @id @default(cuid())
  schoolId      String
  fullName      String
  email         String
  phone         String?
  image         String? // profile photo URL
  signature     String? // signature image URL for report cards
  bioData       Json?
  accountStatus String   @default("active") // active / suspended
  partTime      Boolean  @default(false)
  workDays      Int[] // 0=Mon .. 4=Fri
  dayStartTime  String? // e.g. "08:00"
  dayEndTime    String? // e.g. "15:00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  school                School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments           Assignment[]
  user                  User?
  timetableEntries      TimetableEntry[]
  staffAvailabilities   StaffAvailability[]
  addonTimetableEntries AddonTimetableEntry[]
  taughtTopics          TaughtTopic[]
  attendanceRecords     StaffAttendanceRecord[]

  @@unique([schoolId, email])
  @@index([schoolId])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// ClassSubject — links subjects to classes for department handling
// ---------------------------------------------------------------------------

model ClassSubject {
  id         String @id @default(cuid())
  schoolId   String
  classId    String
  subjectId  String
  department String @default("general") // general / science / art / commercial

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([classId, subjectId])
  @@index([schoolId])
  @@map("class_subjects")
}

// ---------------------------------------------------------------------------

model Subject {
  id       String  @id @default(cuid())
  schoolId String
  name     String
  code     String? // WAEC/NECO alignment, optional

  school                School                        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments           Assignment[]
  questions             Question[]
  stimuli               Stimulus[]
  questionGroups        QuestionGroup[]
  syllabi               Syllabus[]
  lessonNotes           LessonNote[]
  exams                 Exam[]
  subjectResults        SubjectResult[]
  timetableEntries      TimetableEntry[]
  classSubjects         ClassSubject[]
  subjectRequirements   SubjectTimetableRequirement[]
  addonTimetableEntries AddonTimetableEntry[]
  taughtTopics          TaughtTopic[]

  homeworks           Homework[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

enum AssignmentType {
  subject_teacher
  class_teacher
  hod
  exam_officer
  school_admin
  fee_status_manager
  bursar            // ← add
  receptionist
}

// Assignment = scoped, versioned, many-to-many staff role.
// Effective permissions = union of all active assignments for current session/term.
model Assignment {
  id             String         @id @default(cuid())
  schoolId       String
  staffId        String
  assignmentType AssignmentType
  subjectId      String? // required for subject_teacher, hod
  classId        String? // required for subject_teacher, class_teacher
  sessionId      String?
  termId         String? // null = whole session
  isTemporary    Boolean        @default(false)
  startDate      DateTime?
  endDate        DateTime?
  createdBy      String?
  createdAt      DateTime       @default(now())

  staff   Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id])
  class   Class?   @relation(fields: [classId], references: [id])
  term    Term?    @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([staffId])
  @@index([sessionId])
  @@map("assignments")
}

// ---------------------------------------------------------------------------
// PRD 03: Student Management
// ---------------------------------------------------------------------------

enum StudentStatus {
  active
  withdrawn
  graduated
}

model Student {
  id                 String        @id @default(cuid())
  schoolId           String
  admissionNumber    String // unique per school, human-readable key
  firstName          String
  middleName         String?
  lastName           String
  email              String? // student email
  dateOfBirth        DateTime?
  ethnicity          String?
  religion           String?
  gender             String?
  passportPhoto      String?
  currentClassId     String?
  department         String        @default("") // SSS only: "science" / "art" / "commercial" / ""
  admissionDate      DateTime?
  status             StudentStatus @default(active)
  userId             String?       @unique // links to User for student login
  // Extended bio-data (blood_group, genotype, previous_school, etc.) — school-configurable
  bioData            Json?
  isClassCaptain     Boolean       @default(false)
  isViceClassCaptain Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  currentClass      Class?             @relation(fields: [currentClassId], references: [id])
  user              User?              @relation(fields: [userId], references: [id])
  guardians         Guardian[]
  subjectResults    SubjectResult[]
  termResults       TermResult[]
  examAttempts      ExamAttempt[]
  manualScores      ManualScore[]
  consentRecords    ConsentRecord[]
  taughtTopics      TaughtTopic[]
  attendanceRecords AttendanceRecord[]
  payments          StudentPayment[]
  homeworkAttempts  HomeworkAttempt[]

  originTransfers      GroupStudentTransferRecord[] @relation("TransferOriginStudent")
  destinationTransfers GroupStudentTransferRecord[] @relation("TransferDestinationStudent")

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([currentClassId])
  @@map("students")
}

model Guardian {
  id               String  @id @default(cuid())
  studentId        String
  relationship     String // father / mother / guardian / other
  fullName         String
  phone            String // required for notification addon (must be WhatsApp-capable)
  email            String? // required for notification addon in production
  address          String?
  isPrimaryContact Boolean @default(false)
  parentUserId     String? // links to User with role=parent

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  consentRecords ConsentRecord[]

  @@index([studentId])
  @@map("guardians")
}

// ---------------------------------------------------------------------------
// Authentication (platform-wide; supports Super Admin, staff, students, parents)
// ---------------------------------------------------------------------------

enum UserRole {
  super_admin
  platform_owner
  proprietor
  staff
  student
  parent
  referral
}

model User {
  id                 String   @id @default(cuid())
  schoolId           String? // null for super_admin / platform_owner / proprietor
  email              String   @unique
  passwordHash       String
  role               UserRole
  staffId            String?  @unique // link when role = staff
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)

  // Proprietor-only fields (PRD 19) — null for all other roles
  proprietorGroupId         String?
  proprietorPermissionLevel String? // "full" / "view_only"

  // Referral-only field — links referral agent login to their Referral record
  referralId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school           School?         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff            Staff?          @relation(fields: [staffId], references: [id])
  student          Student?
  pushDevices      PushDevice[]
  proprietorGroup  SchoolGroup?    @relation("ProprietorGroup", fields: [proprietorGroupId], references: [id])
  referral         Referral?       @relation(fields: [referralId], references: [id])
  verifiedPayments Payment[]
  createdTickets   Ticket[]        @relation("TicketCreator")
  assignedTickets  Ticket[]        @relation("TicketAssignee")
  ticketMessages   TicketMessage[]

  @@index([schoolId])
  @@index([proprietorGroupId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// PRD 11: Audit Logging (cross-cutting scaffold)
// ---------------------------------------------------------------------------

model AuditLog {
  id                     String   @id @default(cuid())
  schoolId               String?
  actorId                String? // staff/admin/user id
  actorAssignmentContext String? // which role/assignment they acted under
  action                 String // create / update / delete / approve / promote / etc.
  entityType             String // e.g. subject_result, question, student
  entityId               String?
  beforeValue            Json?
  afterValue             Json?
  timestamp              DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PRD 11 — NDPR Compliance: Consent Record
// ---------------------------------------------------------------------------

model ConsentRecord {
  id            String   @id @default(cuid())
  studentId     String
  guardianId    String?
  consentType   String // e.g. "data_processing", "photo_use", "contact"
  consentedAt   DateTime @default(now())
  consentMethod String // "registration_form" / "csv_bulk" / "admin_input"
  schoolId      String?

  student  Student?  @relation(fields: [studentId], references: [id])
  guardian Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)
  school   School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([guardianId])
  @@map("consent_records")
}

// ---------------------------------------------------------------------------
// PRD 14: AI Provider Configuration (Super Admin only)
// ---------------------------------------------------------------------------

model AiProviderConfig {
  id               String   @id @default(cuid())
  label            String
  baseUrl          String
  apiKeyEncrypted  String // encrypted at rest, never returned plaintext
  defaultModelName String
  priority         Int      @default(1) // lower number is tried first; 1 = default provider
  isActive         Boolean  @default(false)
  createdBy        String?
  createdAt        DateTime @default(now())

  taskProfiles AiTaskProfile[]
  callLogs     AiCallLog[]

  @@map("ai_provider_configs")
}

model AiTaskProfile {
  id                   String   @id @default(cuid())
  taskType             String // lesson_note_generation / question_generation / essay_grading / comment_drafting
  providerConfigId     String
  modelNameOverride    String?
  temperature          Float?   @default(0.7)
  maxTokens            Int?     @default(4096)
  systemPromptTemplate String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  provider AiProviderConfig @relation(fields: [providerConfigId], references: [id], onDelete: Cascade)

  @@unique([taskType, providerConfigId])
  @@map("ai_task_profiles")
}

model AiCallLog {
  id               String   @id @default(cuid())
  taskType         String
  schoolId         String?
  userId           String?
  providerConfigId String?
  modelName        String
  promptTokens     Int?
  completionTokens Int?
  status           String // success / error / timeout
  errorDetail      String?
  latencyMs        Int?
  createdAt        DateTime @default(now())

  provider AiProviderConfig? @relation(fields: [providerConfigId], references: [id], onDelete: SetNull)

  @@index([taskType])
  @@index([schoolId])
  @@index([createdAt])
  @@map("ai_call_logs")
}

model AiRateLimitSetting {
  id                    String   @id @default(cuid())
  enabled               Boolean  @default(true)
  perUserDailyQuota     Int      @default(15)
  perUserPerMinuteBurst Int      @default(5)
  perSchoolDailyCap     Int      @default(300)
  resetsAtUtc           String   @default("00:00") // fixed daily rollover, "HH:MM" UTC
  createdBy             String?
  updatedAt             DateTime @updatedAt

  @@map("ai_rate_limit_settings")
}

model AiRateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique // user:{id}:day:YYYY-MM-DD / user:{id}:min:{epochMinute} / school:{id}:day:YYYY-MM-DD
  windowStart DateTime
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@index([windowStart])
  @@map("ai_rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// PRD 04: Syllabus & Lesson Notes
// ---------------------------------------------------------------------------

model Syllabus {
  id           String   @id @default(cuid())
  schoolId     String
  subjectId    String
  classLevel   String // e.g. "JSS1", "SS2" — level-wide, not per-arm
  sessionId    String
  file         String? // uploaded document path/URL
  parsedTopics Json? // extracted/structured topic list
  createdAt    DateTime @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([schoolId, subjectId, classLevel, sessionId])
  @@index([schoolId])
  @@map("syllabi")
}

// ---------------------------------------------------------------------------
// CurriculumTopic — NERDC reference curriculum (pre-seeded) + school overrides
// ---------------------------------------------------------------------------

model CurriculumTopic {
  id                    String  @id @default(cuid())
  classLevel            String // JSS1 / JSS2 / JSS3 / SS1 / SS2 / SS3
  term                  String // FIRST / SECOND / THIRD
  subject               String // subject name (NERDC standard name)
  week                  Int
  weekSuffix            String  @default("") // "" for single-week, "A", "B", "C" for multi-week splits
  topic                 String
  subTopics             Json? // array of sub-topics / details
  behaviouralObjectives Json? // array of behavioural objective strings
  isSystem              Boolean @default(true) // true = NERDC default, false = school override
  schoolId              String? // null = NERDC defaults; set when a school overrides

  @@unique([classLevel, term, subject, week, weekSuffix, schoolId])
  @@index([classLevel, subject])
  @@map("curriculum_topics")
}

model NerdcContent {
  id        String   @id @default(cuid())
  content   String // raw markdown content of nerdc.md
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("nerdc_content")
}

model LessonNote {
  id                     String   @id @default(cuid())
  schoolId               String
  subjectId              String
  classId                String
  termId                 String
  syllabusId             String?
  topic                  String
  themeOrAspect          String? // theme / aspect of the syllabus
  duration               String? // e.g. "40 minutes"
  referenceBooks         String? // recommended textbooks
  instructionalMaterials String? // teaching aids
  // Structured lesson note sections
  previousKnowledge      String? // what students should already know
  introduction           String? // set induction / opening activity
  behaviouralObjectives  Json? // array of objective strings
  content                String? // students' note / board summary
  objectiveCoverageMap   String? // traceability: which parts of content cover which objective
  presentationSteps      Json? // array of {step_number, objective_reference, teacher_activity, student_activity}
  evaluation             String? // evaluation questions
  summary                String? // summary / conclusion
  assignment             String? // homework
  source                 String // manual / ai_generated
  status                 String   @default("draft") // draft / published
  createdBy              String // staff id
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])
  term    Term    @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([subjectId, classId, termId])
  @@map("lesson_notes")
}

// ---------------------------------------------------------------------------
// PRD 05: Question Bank & Exam Setup
// ---------------------------------------------------------------------------

model Stimulus {
  id        String  @id @default(cuid())
  type      String // passage / image / table / audio
  content   String
  subjectId String
  reusable  Boolean @default(false)

  subject Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  groups  QuestionGroup[]

  @@index([subjectId])
  @@map("stimuli")
}

model QuestionGroup {
  id                   String  @id @default(cuid())
  stimulusId           String?
  subjectId            String
  internallyShufflable Boolean @default(false)

  stimulus  Stimulus?  @relation(fields: [stimulusId], references: [id])
  subject   Subject    @relation(fields: [subjectId], references: [id])
  questions Question[]

  @@index([subjectId])
  @@map("question_groups")
}

enum QuestionType {
  mcq
  essay
}

enum QuestionStatus {
  draft
  pending_review
  approved
  archived
}

model Question {
  id              String         @id @default(cuid())
  schoolId        String
  subjectId       String
  classLevel      String?
  topic           String?
  type            QuestionType
  questionGroupId String?
  text            String
  marks           Float          @default(1)
  difficulty      String? // optional tag
  source          String // manual / csv_import / ai_generated
  status          QuestionStatus @default(draft)
  createdBy       String
  lessonNoteId    String? // provenance if AI-generated
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  school         School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject           @relation(fields: [subjectId], references: [id])
  group          QuestionGroup?    @relation(fields: [questionGroupId], references: [id])
  mcqOptions     McqOption[]
  essaySpec      EssayGradingSpec?
  examQuestions  ExamQuestion[]
  studentAnswers StudentAnswer[]

  @@index([schoolId])
  @@index([subjectId, status])
  @@map("questions")
}

model QuizQuestion {
  id               String   @id @default(cuid())
  classLevel       String // JSS1..SS3
  term             String // FIRST / SECOND / THIRD
  subject          String // NERDC subject name
  topic            String
  curriculumTopicId String?
  questionText     String
  options          Json // string[4]
  correctIndex     Int
  explanation      String?
  difficulty       Int     @default(1) // 1..3
  points           Int     @default(10)
  status           String  @default("live") // live | retired
  createdAt        DateTime @default(now())

  attempts QuizAttemptAnswer[]

  @@index([classLevel, term, subject, topic])
  @@index([status])
  @@map("quiz_questions")
}

model QuizAttempt {
  id           String   @id @default(cuid())
  studentId    String
  schoolId     String
  classId      String
  classLevel   String
  term         String
  subject      String? // null = mixed/daily quiz
  mode         String   // "daily" | "practice"
  totalQuestions Int
  correctCount Int
  earnedPoints Int
  accuracyPct Int
  durationSec  Int?
  countsForLeaderboard Boolean @default(true)
  completedAt  DateTime @default(now())

  answers QuizAttemptAnswer[]

  @@index([schoolId])
  @@index([studentId])
  @@index([classId])
  @@index([completedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id            String   @id @default(cuid())
  quizAttemptId String
  quizQuestionId String
  selectedIndex Int?
  correct       Boolean
  pointsEarned  Int

  attempt  QuizAttempt  @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [quizQuestionId], references: [id])

  @@index([quizAttemptId])
  @@map("quiz_attempt_answers")
}

model McqOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String
  isCorrect  Boolean @default(false)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("mcq_options")
}

model EssayGradingSpec {
  id            String  @id @default(cuid())
  questionId    String  @unique
  modelAnswer   String
  rubricPoints  Json // array of { description, mark }
  // AI grading prompt overrides, if any
  gradingPrompt String?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("essay_grading_specs")
}

// ---------------------------------------------------------------------------
// PRD 06: Exam Delivery
// ---------------------------------------------------------------------------

enum ExamAttemptType {
  original
  resit
}

enum ExamStatus {
  draft
  pending_review
  approved
  rejected
  published
}

model Exam {
  id                   String          @id @default(cuid())
  schoolId             String
  subjectId            String
  classId              String? // kept for backward compat; use ExamClass for multiple
  termId               String
  assessmentTypeId     String
  subAssessmentTypeId String? // child AssessmentType id; null = legacy single exam
  durationMinutes      Int
  shuffleEnabled       Boolean         @default(true)
  status               ExamStatus      @default(draft)
  attemptType          ExamAttemptType @default(original)
  originalExamId       String?
  // Review workflow: subject teacher creates, admin/form master submits, exam officer approves/rejects
  createdBy            String? // staff id of creator
  submittedForReviewAt DateTime?
  reviewedBy           String? // staff id of the exam officer
  reviewedAt           DateTime?
  reviewComment        String? // comment from exam officer (approve or reject reason)
  // Per-exam sub-assessment weight distribution, e.g. [{ subAssessmentTypeId: "xxx", weightPercentage: 20 }]
  // Must sum to the parent assessment type's school-level weight.
  subAssessmentWeights Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @default(now()) @updatedAt

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id])
  class          Class?          @relation(fields: [classId], references: [id])
  term           Term            @relation(fields: [termId], references: [id])
  examQuestions  ExamQuestion[]
  attempts       ExamAttempt[]
  classes        ExamClass[]
  manualScores   ManualScore[]
  offlineBundles OfflineBundle[]
  offlineStatus  String          @default("none") // none | released | synced

  @@index([schoolId])
  @@index([subjectId, classId, termId])
  @@index([status])
  @@index([subAssessmentTypeId])
  @@map("exams")
}

model ExamClass {
  id      String @id @default(cuid())
  examId  String
  classId String

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id])

  @@unique([examId, classId])
  @@index([examId])
  @@index([classId])
  @@map("exam_classes")
}

model ExamQuestion {
  id         String @id @default(cuid())
  examId     String
  questionId String

  exam     Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@index([examId])
  @@map("exam_questions")
}

enum AttemptStatus {
  in_progress
  submitted
  absent
  pending_resit
}

enum SyncStatus {
  local_only
  queued
  synced
}

model ExamAttempt {
  id                  String        @id @default(cuid())
  examId              String
  studentId           String
  startedAt           DateTime      @default(now())
  submittedAt         DateTime?
  status              AttemptStatus @default(in_progress)
  syncStatus          SyncStatus    @default(synced) // local_only for offline hub
  shuffledQuestionIds Json? // ordered array of question IDs for this student
  shuffledOptionOrder Json? // map of questionId → ordered option IDs
  endsAt              DateTime? // server-side timer end time (startedAt + durationMinutes)
  hubId               String?
  hubAttemptId        String?
  hub                 Hub?          @relation(fields: [hubId], references: [id])
  createdAt           DateTime      @default(now())

  exam    Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id])
  answers StudentAnswer[]

  @@unique([hubId, hubAttemptId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_attempts")
}

model StudentAnswer {
  id                  String   @id @default(cuid())
  attemptId           String
  questionId          String
  mcqSelectedOptionId String?
  essayResponseText   String?
  localChecksum       String?
  checksumFlagged     Boolean  @default(false)
  gradedScore         Float? // null until graded
  // AI essay grading fields (PRD 07)
  aiSuggestedScore    Float?
  aiReasoning         String?
  rubricPointMatches  Json?
  finalScore          Float? // null until teacher reviews
  gradedBy            String? // teacher id once reviewed
  gradingStatus       String   @default("ai_pending") // ai_pending / ai_complete / teacher_reviewed
  createdAt           DateTime @default(now())

  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@index([attemptId])
  @@map("student_answers")
}

// ---------------------------------------------------------------------------
// PRD 08: Results, Grading & Report Cards
// ---------------------------------------------------------------------------

model AssessmentType {
  id        String   @id @default(cuid())
  schoolId  String
  name      String // e.g. "Mid Term Test"
  code      String   @default("") // e.g. "MDT" — short code used elsewhere (results, exams)
  parentId  String? // self-reference for sub-assessments
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  parent   AssessmentType?  @relation("SubAssessments", fields: [parentId], references: [id])
  children AssessmentType[] @relation("SubAssessments")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, name, parentId])
  @@unique([schoolId, code, parentId])
  @@index([schoolId])
  @@map("assessment_types")
}

// ---------------------------------------------------------------------------
// RemarkTemplate — school-seeded comment templates for teacher/principal remarks
// ---------------------------------------------------------------------------
model RemarkTemplate {
  id        String   @id @default(cuid())
  schoolId  String? // null = platform-wide default available to every school
  type      String // "teacher" | "principal"
  text      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, type])
  @@map("remark_templates")
}

model AssessmentWeighting {
  id               String  @id @default(cuid())
  schoolId         String
  subjectId        String?
  assessmentTypeId String // references AssessmentType.code
  weightPercentage Float // percentage of total term score (all types must sum to 100)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, subjectId, assessmentTypeId])
  @@map("assessment_weightings")
}

// ---------------------------------------------------------------------------
// ManualScore — teacher-entered raw scores for exam components that are not
// delivered on-platform (e.g. a maths theory paper, practicals).
// Also used to override platform-computed scores (e.g. AI essay grade override).
// One row per student × exam × sub-assessment component.
// ---------------------------------------------------------------------------
model ManualScore {
  id                    String   @id @default(cuid())
  examId                String
  studentId             String
  subAssessmentTypeCode String // "OBJ" | "THEORY" | "PRC" — matches AssessmentType.code
  rawScore              Float // raw score as entered by the teacher
  maxRawScore           Float // denominator the teacher scored out of (for scaling)
  enteredBy             String // staff id
  note                  String? // optional teacher note
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([examId, studentId, subAssessmentTypeCode])
  @@index([examId])
  @@index([studentId])
  @@map("manual_scores")
}

model SubjectResult {
  id        String @id @default(cuid())
  studentId String
  subjectId String
  termId    String

  subject          Subject  @relation(fields: [subjectId], references: [id])
  student          Student  @relation(fields: [studentId], references: [id])
  term             Term     @relation(fields: [termId], references: [id])
  assessmentScores Json? // per assessment type: { raw, weight, weighted }
  totalScore       Float?
  grade            String?
  subjectPosition  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([studentId, subjectId, termId])
  @@index([termId])
  @@map("subject_results")
}

model TermResult {
  id        String @id @default(cuid())
  studentId String
  termId    String

  student           Student            @relation(fields: [studentId], references: [id])
  term              Term               @relation(fields: [termId], references: [id])
  verificationCodes VerificationCode[]

  overallAverage    Float?
  overallPosition   Int?
  attendanceSummary Json?
  affectiveRatings  Json? // school-configurable list
  teacherComment    String?
  principalComment  String?
  cumulativeAverage Float?
  status            String    @default("computed") // computed / finalised / withheld
  finalizedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([studentId, termId])
  @@index([termId])
  @@map("term_results")
}

model ReportCardTemplate {
  id           String   @id @default(cuid())
  schoolId     String
  appliesTo    String? // e.g. "junior", "senior", or class level
  layoutConfig Json? // which fields appear, ordering, branding
  sessionId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("report_card_templates")
}

// ---------------------------------------------------------------------------
// PRD 09: Result Verification Portal
// ---------------------------------------------------------------------------

model VerificationCode {
  id                String   @id @default(cuid())
  termResultId      String
  code              String   @unique
  status            String   @default("active") // active / revoked
  generatedAt       DateTime @default(now())
  regeneratedReason String?

  termResult TermResult @relation(fields: [termResultId], references: [id])

  @@index([code])
  @@index([termResultId])
  @@map("verification_codes")
}

// ---------------------------------------------------------------------------
// PRD 10: Timetable
// ---------------------------------------------------------------------------

model TimetablePeriod {
  id         String @id @default(cuid())
  schoolId   String
  name       String // e.g. "Period 1"
  startTime  String // e.g. "08:00"
  endTime    String // e.g. "08:40"
  periodType String @default("period") // assembly / period / break / closing

  school  School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  entries TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("timetable_periods")
}

model TimetableEntry {
  id        String  @id @default(cuid())
  schoolId  String
  classId   String
  periodId  String
  subjectId String
  staffId   String
  dayOfWeek Int // 0=Monday .. 4=Friday
  roomId    String? // nullable — for manual room assignment after generation

  school  School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class           @relation(fields: [classId], references: [id])
  period  TimetablePeriod @relation(fields: [periodId], references: [id])
  subject Subject         @relation(fields: [subjectId], references: [id])
  staff   Staff           @relation(fields: [staffId], references: [id])
  room    Room?           @relation(fields: [roomId], references: [id])

  // NOTE: no unique constraint — SSS classes can have two departmental subjects in the same period (paired)
  @@index([classId, dayOfWeek])
  @@index([schoolId])
  @@map("timetable_entries")
}

// ---------------------------------------------------------------------------
// PRD 17: Timetable Generator Addon Models (addon-specific, gated behind addon check)
// ---------------------------------------------------------------------------

model SubjectTimetableRequirement {
  id                    String  @id @default(cuid())
  schoolId              String
  subjectId             String
  classId               String? // null if applied level-wide
  classLevel            String? // e.g. "JSS1"
  weeklyPeriodsRequired Int
  doublePeriodAllowed   Boolean @default(true)
  preferredTimeOfDay    String  @default("none") // morning / afternoon / none
  isPractical           Boolean @default(false)
  requiresRoomTypeId    String?

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@map("subject_timetable_requirements")
}

model StaffAvailability {
  id                 String   @id @default(cuid())
  schoolId           String
  staffId            String
  day                Int // 0=Monday .. 4=Friday
  availablePeriodIds String[] // array of period IDs or names
  maxPeriodsPerDay   Int      @default(8)
  maxPeriodsPerWeek  Int      @default(40)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, day])
  @@map("staff_availability")
}

model TimetableTemplate {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  appliesTo String[] // e.g. ["JSS1", "JSS2"] or ["all"]

  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolDays SchoolDay[]
  periods    AddonPeriod[]
  timetables AddonTimetable[]

  @@unique([schoolId, name])
  @@map("timetable_templates")
}

model SchoolDay {
  id            String  @id @default(cuid())
  templateId    String
  dayName       String // e.g. "Monday"
  dayIndex      Int // 0=Monday .. 4=Friday
  isTeachingDay Boolean @default(true)

  template TimetableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("school_days")
}

model AddonPeriod {
  id           String @id @default(cuid())
  templateId   String
  periodNumber Int
  startTime    String // e.g. "08:00"
  endTime      String // e.g. "08:40"
  periodType   String // teaching / break / assembly / fixed_other

  template TimetableTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("addon_periods")
}

model SchoolTimetableRule {
  id         String  @id @default(cuid())
  schoolId   String
  ruleType   String // max_consecutive_periods, max_subject_periods_per_day, fixed_period_assignment, room_exclusivity, subject_time_preference, max_teacher_subjects, practical_double_period, etc.
  parameters Json // rule configuration parameters
  isHard     Boolean @default(true)
  weight     Int     @default(100)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_timetable_rules")
}

model RoomType {
  id       String @id @default(cuid())
  schoolId String
  name     String // e.g. "Physics Lab"
  rooms    Room[]

  @@map("room_types")
}

model Room {
  id         String @id @default(cuid())
  schoolId   String
  name       String // e.g. "Room 101"
  roomTypeId String
  capacity   Int    @default(40)

  roomType         RoomType         @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  classes          Class[]

  @@map("rooms")
}

model AddonTimetable {
  id              String   @id @default(cuid())
  schoolId        String
  sessionId       String
  termId          String
  templateId      String
  status          String   @default("draft") // draft / published / archived
  generatedAt     DateTime @default(now())
  generationScore Int      @default(0)

  school   School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  template TimetableTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  entries  AddonTimetableEntry[]
  runs     TimetableGenerationRun[]

  @@map("addon_timetables")
}

model AddonTimetableEntry {
  id          String  @id @default(cuid())
  timetableId String
  classId     String
  periodId    String // references AddonPeriod
  day         Int // 0=Monday .. 4=Friday
  subjectId   String
  staffId     String?
  roomId      String?
  isLocked    Boolean @default(false)

  timetable AddonTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  class     Class          @relation(fields: [classId], references: [id])
  subject   Subject        @relation(fields: [subjectId], references: [id])
  staff     Staff?         @relation(fields: [staffId], references: [id])

  @@map("addon_timetable_entries")
}

model TimetableGenerationRun {
  id                       String    @id @default(cuid())
  timetableId              String
  triggeredBy              String
  startedAt                DateTime  @default(now())
  completedAt              DateTime?
  status                   String // success / partial / failed
  finalScore               Int       @default(0)
  hardConstraintViolations String[] // list of conflict descriptions
  iterationsRun            Int       @default(0)

  timetable AddonTimetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)

  @@map("timetable_generation_runs")
}

model TimetableWizard {
  id          String   @id @default(cuid())
  schoolId    String   @unique
  currentStep Int      @default(1) // 1..7
  stepData    Json? // accumulated answers {classes, teacherAvailability, periods, subjectFrequency, teacherLoad}
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("timetable_wizards")
}

// ---------------------------------------------------------------------------

model FeeStatus {
  id        String   @id @default(cuid())
  studentId String
  termId    String
  status    String   @default("not_cleared") // cleared / not_cleared / partial
  setBy     String? // admin/bursar staff id
  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([studentId, termId])
  @@index([termId])
  @@map("fee_statuses")
}

model FeeItem {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String
  level     String
  name      String
  amount    Decimal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  @@unique([termId, level, name])
  @@index([schoolId, termId])
  @@map("fee_items")
}

model StudentPayment {
  id         String   @id @default(cuid())
  schoolId   String
  studentId  String
  termId     String
  amount     Decimal
  method     String   @default("cash")
  paymentDate DateTime?
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())
  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)
  @@index([studentId, termId])
  @@index([schoolId, termId])
  @@map("student_payments")
}

model FeeReminderConfig {
  id            String    @id @default(cuid())
  schoolId      String    @unique
  weeklyEnabled Boolean   @default(false)
  dayOfWeek     Int       @default(1)
  lastSentAt    DateTime?
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  @@map("fee_reminder_configs")
}

// ---------------------------------------------------------------------------
// PRD 13: Parent Portal & Notifications
// ---------------------------------------------------------------------------

model ParentAccount {
  id                      String   @id @default(cuid())
  guardianId              String // links to Guardian entity (PRD 03)
  email                   String
  passwordHash            String   @default("")
  phone                   String?
  notificationPreferences Json? // which channels/events
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([email])
  @@index([guardianId])
  @@map("parent_accounts")
}

model Notification {
  id             String    @id @default(cuid())
  schoolId       String?
  recipientType  String // parent / staff
  recipientId    String
  channel        String // sms / push / in_app / email
  eventType      String // result_published / fee_status_changed / general_notice / exam_graded
  title          String?
  content        String
  isRead         Boolean   @default(false)
  readAt         DateTime?
  sentAt         DateTime  @default(now())
  deliveryStatus String    @default("pending") // pending / sent / failed / read

  @@index([recipientType, recipientId, sentAt])
  @@map("notifications")
}

model PushDevice {
  id        String   @id @default(cuid())
  userId    String
  fcmToken  String?  @unique
  schoolId  String?
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model Announcement {
  id          String    @id @default(cuid())
  schoolId    String
  title       String
  content     String
  targetRoles String[] // ["student", "staff", "parent"]
  isSticky    Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("announcements")
}

model PlatformAd {
  id          String   @id @default(cuid())
  title       String
  blobUrl     String
  targetRoles String[] // subset of SessionPayload.role values
  expiresAt   DateTime? // null = never expires
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active, expiresAt])
  @@map("platform_ads")
}

enum LicenseDurationType {
  monthly
  termly
}

enum LicenseStageName {
  basic
  standard
  premium
}

model LicensePlan {
  id             String              @id @default(cuid())
  name           String              @unique // e.g. "Monthly", "Termly"
  durationType   LicenseDurationType
  price          Decimal? // deprecated — use stage-specific prices below
  basicPrice     Decimal? // price for Basic-stage schools
  standardPrice  Decimal? // price for Standard-stage schools
  premiumPrice   Decimal? // price for Premium-stage schools
  groupPrice     Decimal? // per-school base price for multi-branch groups (progressive discount applies)
  durationDays   Int? // e.g. 30 or 90
  // When true, groupPrice field is available for multi-branch group billing
  isGroupBilling Boolean             @default(false)
  isActive       Boolean             @default(true) // can this plan be assigned to new schools?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  schoolLicenses SchoolLicense[]
  payments       Payment[]
  cashCodes      CashCode[]

  @@map("license_plans")
}

enum LicenseStatus {
  active
  grace_period
  expired
  suspended
}

model SchoolLicense {
  id               String            @id @default(cuid())
  schoolId         String
  planId           String
  stage            LicenseStageName? // snapshot of the school's stage at license creation
  startDate        DateTime
  endDate          DateTime
  status           LicenseStatus     @default(active)
  paymentReference String? // free-text record of how/when the school paid
  setBy            String? // Platform Owner user id
  autoRenewIntent  Boolean           @default(false) // informational only
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan   LicensePlan @relation(fields: [planId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@map("school_licenses")
}

// ---------------------------------------------------------------------------
// PRD X: Payment Methods & Payments
// ---------------------------------------------------------------------------

enum PaymentMethodType {
  bank_transfer
  cash
  online
}

model PaymentMethod {
  id        String            @id @default(cuid())
  type      PaymentMethodType
  label     String // display name e.g. "GTBank", "Cash", "Paystack"
  isActive  Boolean           @default(true)
  details   Json? // bank_transfer: {bankName, accountNumber, accountName, instructions} / online: {provider, publicKey} / cash: null
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments            Payment[]
  schoolRegistrations SchoolRegistration[]

  @@map("payment_methods")
}

model CashCode {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "CASH-A3B7K9"
  planId         String
  schoolId       String? // pre-assigned to a school (optional)
  isUsed         Boolean   @default(false)
  usedAt         DateTime?
  usedBySchoolId String?
  createdAt      DateTime  @default(now())

  plan LicensePlan @relation(fields: [planId], references: [id])

  @@index([code])
  @@map("cash_codes")
}

model Addon {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  features      Json? // array of feature descriptions
  // Stage-specific pricing — mirrors LicensePlan; one of basic/standard/premium is required
  basicPrice    Decimal? // price for Basic-stage schools
  standardPrice Decimal? // price for Standard-stage schools
  premiumPrice  Decimal? // price for Premium-stage schools
  // Legacy single-price field — kept for backwards compatibility
  price         Decimal? // deprecated — use stage-specific prices above
  durationDays  Int? // null = one-time/permanent, set = renewable
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  schoolAddons    SchoolAddon[]
  activationCodes AddonCode[]
  groupAddons     GroupAddonSubscription[]
  payments        Payment[]

  @@map("addons")
}

model AddonCode {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "ADDON-A3B7K9"
  addonId        String
  schoolId       String? // pre-assigned to a school (optional)
  isUsed         Boolean   @default(false)
  usedAt         DateTime?
  usedBySchoolId String?
  createdAt      DateTime  @default(now())

  addon Addon @relation(fields: [addonId], references: [id])

  @@index([code])
  @@map("addon_codes")
}

model SchoolAddon {
  id             String    @id @default(cuid())
  schoolId       String
  addonId        String
  status         String    @default("active") // active, expired, suspended
  activatedAt    DateTime  @default(now())
  expiresAt      DateTime? // null = permanent
  activatedVia   String // "purchase" or "code"
  activationCode String? // the code used (if via code)
  paymentId      String? // the payment (if via purchase)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  addon  Addon  @relation(fields: [addonId], references: [id])

  @@unique([schoolId, addonId])
  @@index([schoolId])
  @@map("school_addons")
}

model Payment {
  id              String    @id @default(cuid())
  schoolId        String
  planId          String? // null when the payment is for an addon (see addonId)
  addonId         String? // set when the payment is for an addon purchase instead of a license plan
  amount          Decimal
  paymentMethodId String
  status          String    @default("pending") // pending, verified, failed, refunded
  cashCodeId      String? // links to the cash code used (for cash payments)
  reference       String? // user-entered ref (bank transfer) or gateway ref (online)
  proofUrl        String? // uploaded receipt image for bank transfer
  notes           String?
  verifiedById    String?
  verifiedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school        School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan          LicensePlan?  @relation(fields: [planId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  verifiedBy    User?         @relation(fields: [verifiedById], references: [id])
  addon         Addon?        @relation(fields: [addonId], references: [id])

  @@index([schoolId])
  @@index([status])
  @@index([addonId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Paystack Payment Intents (generic, console-driven charges)
// ---------------------------------------------------------------------------

model PaymentIntent {
  id          String   @id @default(cuid())
  schoolId    String? // school-scoped charge (school plan / school addon)
  groupId     String? // group-scoped charge (proprietor group addon)
  amount      Decimal
  currency    String   @default("NGN")
  email       String // Paystack customer email
  status      String   @default("pending") // pending | paid | failed
  paystackRef String?  @unique
  kind        String // school_plan | school_addon | group_addon
  metadata    Json? // includes redirectTo and fulfilment details (planId, addonId, durationDays, methodId, stage)
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([groupId])
  @@map("payment_intents")
}

// ---------------------------------------------------------------------------
// Support Tickets
// ---------------------------------------------------------------------------

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

model Ticket {
  id           String         @id @default(cuid())
  schoolId     String
  title        String
  description  String
  status       TicketStatus   @default(open)
  priority     TicketPriority @default(medium)
  category     String? // e.g. "billing", "technical", "feature_request", "other"
  createdById  String
  assignedToId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy  User            @relation("TicketCreator", fields: [createdById], references: [id])
  assignedTo User?           @relation("TicketAssignee", fields: [assignedToId], references: [id])
  messages   TicketMessage[]

  @@index([schoolId])
  @@index([status])
  @@index([createdById])
  @@map("tickets")
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  content   String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@map("ticket_messages")
}

// ---------------------------------------------------------------------------
// PRD 18: Period Tracker Addon — track curriculum coverage by teachers
// ---------------------------------------------------------------------------

model TaughtTopic {
  id                String    @id @default(cuid())
  schoolId          String
  classId           String
  subjectId         String
  curriculumTopicId String?
  termId            String?
  teacherId         String // Staff id
  teacherMarked     Boolean   @default(false)
  captainMarked     Boolean   @default(false)
  studentId         String? // Student (captain/vice) who marked
  teacherMarkedAt   DateTime?
  captainMarkedAt   DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   Class    @relation(fields: [classId], references: [id])
  subject Subject  @relation(fields: [subjectId], references: [id])
  teacher Staff    @relation(fields: [teacherId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])

  @@unique([classId, subjectId, curriculumTopicId, teacherId])
  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
  @@map("taught_topics")
}

// ---------------------------------------------------------------------------
// PRD 19: Daily Attendance Addon — QR-based student & staff attendance
// ---------------------------------------------------------------------------

model AttendanceRecord {
  id        String    @id @default(cuid())
  schoolId  String
  studentId String
  classId   String
  date      DateTime  @db.Date
  periodId  String? // null if period attendance is disabled by school
  status    String // present / absent / late / excused
  signInAt  DateTime? // exact time student signed in (scan or manual)
  signOutAt DateTime? // exact time student signed out (scan)
  scannedBy String // staffId of the person who scanned
  scannedAt DateTime  @default(now())

  school  School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([studentId, date, periodId])
  @@index([schoolId, date])
  @@map("attendance_records")
}

model StaffAttendanceRecord {
  id        String    @id @default(cuid())
  schoolId  String
  staffId   String
  date      DateTime  @db.Date
  status    String // present / absent / late
  signInAt  DateTime? // exact time staff signed in
  signOutAt DateTime? // exact time staff signed out
  scannedBy String // staffId of the scanner
  scannedAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  Staff  @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
  @@map("staff_attendance_records")
}

model IDCardTemplate {
  id        String   @id @default(cuid())
  schoolId  String   @unique
  layout    Json     @default("{}") // logo position, colors, fields, font
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("id_card_templates")
}

// ---------------------------------------------------------------------------
// PRD 20: WhatsApp & SMS Notification Addon
// ---------------------------------------------------------------------------

model NotificationProviderConfig {
  id          String   @id @default(cuid())
  channel     String // whatsapp / sms
  provider    String // twilio / africastalking / custom
  label       String?
  credentials Json // API keys, endpoints, sender IDs
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_provider_configs")
}

model NotificationTemplate {
  id        String   @id @default(cuid())
  eventType String // attendance_marked_absent / result_published / exam_scheduled / fee_reminder
  channel   String // whatsapp / sms
  label     String?
  body      String // template with {{variables}}
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, channel])
  @@map("notification_templates")
}

model NotificationQueue {
  id          String    @id @default(cuid())
  schoolId    String
  eventType   String
  channel     String // whatsapp / sms
  recipient   String // phone number
  message     String
  status      String    @default("pending") // pending / sent / failed
  scheduledAt DateTime // when to send (for random delay 5-50s)
  sentAt      DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@map("notification_queue")
}

model NotificationLog {
  id        String   @id @default(cuid())
  schoolId  String
  eventType String
  channel   String // whatsapp / sms
  recipient String // phone number
  message   String
  status    String // sent / failed
  provider  String?
  error     String?
  sentAt    DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, sentAt])
  @@map("notification_logs")
}

model SchoolNotificationConfig {
  id             String   @id @default(cuid())
  schoolId       String   @unique
  smsActive      Boolean  @default(false)
  whatsappActive Boolean  @default(false)
  enabledEvents  Json     @default("[]") // array of event type strings
  updatedAt      DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_notification_configs")
}

// ---------------------------------------------------------------------------
// PRD 19: Multi-Branch / Group of Schools Management (Addon)
// ---------------------------------------------------------------------------

// A School Group groups multiple school branches under a single proprietor.
// Only Platform Owner can create/modify School Groups and memberships.
model SchoolGroup {
  id            String            @id @default(cuid())
  name          String            @unique // e.g. "XYZ Group of Schools"
  // The fee group (basic/standard/premium) all member schools will use for license pricing.
  // When set, it overrides each member school's individual stage for license computation.
  feeGroupStage LicenseStageName?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdBy     String? // Platform Owner user id

  memberships        GroupMembership[]
  proprietors        User[]                       @relation("ProprietorGroup")
  addonSubscriptions GroupAddonSubscription[]
  transferRecords    GroupStudentTransferRecord[]

  @@map("school_groups")
}

// Links a school to a School Group. A school belongs to at most one group.
model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  schoolId String   @unique // a school can be in at most one group at a time
  addedAt  DateTime @default(now())
  addedBy  String? // Platform Owner user id

  group  SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("group_memberships")
}

// Group-level addon subscription (e.g. Multi-Branch addon is billed at group level, not per school).
// Mirrors SchoolAddon but scoped to a School Group rather than a School.
model GroupAddonSubscription {
  id               String    @id @default(cuid())
  groupId          String
  addonId          String
  status           String    @default("active") // active, expired, suspended
  startDate        DateTime  @default(now())
  endDate          DateTime? // null = permanent
  paymentReference String?
  setBy            String? // Platform Owner user id
  notes            String?

  group SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addon Addon       @relation(fields: [addonId], references: [id])

  @@unique([groupId, addonId])
  @@index([groupId])
  @@map("group_addon_subscriptions")
}

// Tracks cross-branch student transfers between member schools of the same group.
// Origin student record remains untouched; destination gets a new Student record.
model GroupStudentTransferRecord {
  id                   String   @id @default(cuid())
  groupId              String
  originSchoolId       String
  originStudentId      String
  destinationSchoolId  String
  destinationStudentId String
  transferredAt        DateTime @default(now())
  initiatedBy          String? // staff id at destination branch, or proprietor user id
  notes                String?

  group              SchoolGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  originSchool       School      @relation("TransferOriginSchool", fields: [originSchoolId], references: [id], onDelete: Cascade)
  originStudent      Student     @relation("TransferOriginStudent", fields: [originStudentId], references: [id])
  destinationSchool  School      @relation("TransferDestinationSchool", fields: [destinationSchoolId], references: [id], onDelete: Cascade)
  destinationStudent Student     @relation("TransferDestinationStudent", fields: [destinationStudentId], references: [id])

  @@index([groupId])
  @@index([originSchoolId])
  @@index([destinationSchoolId])
  @@index([originStudentId])
  @@index([destinationStudentId])
  @@map("group_student_transfer_records")
}

model Referral {
  id                String   @id @default(cuid())
  fullName          String
  address           String
  dateOfBirth       DateTime
  phoneNumber       String
  email             String   @unique
  whatsappNumber    String
  bankName          String
  bankAccountNumber String
  bankAccountName   String
  passwordHash      String   @default("")
  referralCode      String   @unique
  status            String   @default("active") // active | inactive
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  schools             School[]
  schoolRegistrations SchoolRegistration[]
  commissions         ReferralCommission[]
  users               User[]

  @@index([referralCode])
  @@map("referrals")
}

model SchoolRegistration {
  id                 String   @id @default(cuid())
  // School details
  schoolName         String
  schoolAddress      String?
  schoolPhone        String?
  schoolEmail        String?
  schoolLogo         String?
  // School profile (size bands)
  studentCountBand   String?
  branchCountBand    String?
  teacherCountBand   String?
  // Principal / owner details
  principalFirstName String
  principalLastName  String
  principalEmail     String
  principalPhone     String?
  // Referral
  referralCode       String?
  referralId         String?
  // Registration payment
  registrationFee    Decimal?
  paymentMethodId    String?
  paymentReference   String?
  paymentProofUrl    String?
  paymentStatus      String   @default("unpaid") // unpaid | pending | verified | rejected
  invoiceNumber      String?
  invoiceAmount      Decimal?
  // Status: pending | reviewed | approved | rejected
  status             String   @default("pending")
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  referral      Referral?            @relation(fields: [referralId], references: [id])
  paymentMethod PaymentMethod?       @relation(fields: [paymentMethodId], references: [id])
  commissions   ReferralCommission[]
  invoices      Invoice[]

  @@index([status])
  @@map("school_registrations")
}

model Invoice {
  id             String   @id @default(cuid())
  registrationId String
  invoiceNumber  String   @unique
  amount         Decimal
  currency       String   @default("NGN")
  status         String   @default("pending") // pending | paid | verified | failed
  method         String?  // paystack | bank
  paystackRef    String?  @unique
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  registration SchoolRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId])
  @@map("invoices")
}

model ReferralCommissionSetting {
  id                String   @id @default(cuid())
  registrationFee   Decimal  @default(250000) // registration fee in NGN
  commissionPercent Decimal  @default(20) // percentage of registration fee paid to referrer
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("referral_commission_settings")
}

model ReferralCommission {
  id             String    @id @default(cuid())
  referralId     String
  registrationId String?
  schoolId       String?
  amount         Decimal
  status         String    @default("pending") // pending | paid | rejected
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  referral     Referral            @relation(fields: [referralId], references: [id])
  registration SchoolRegistration? @relation(fields: [registrationId], references: [id])
  school       School?             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([status])
  @@map("referral_commissions")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  schoolId  String
  subject   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([schoolId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  userType       String // "staff" | "parent" | "student"
  userLabel      String?
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// PRD 20: Marketing Homepage — lead capture + CMS-lite content
// ---------------------------------------------------------------------------

model DemoRequest {
  id                String   @id @default(cuid())
  contactName       String
  schoolName        String
  phone             String?
  email             String
  studentCountRange String? // informational, e.g. "100-300"
  message           String?
  status            String   @default("new") // new | contacted | qualified | converted | closed
  source            String   @default("homepage") // which page/section the form was submitted from
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@map("demo_requests")
}

model HomepageContentBlock {
  id           String   @id @default(cuid())
  sectionKey   String   @unique // e.g. hero_headline, hero_subheadline, pricing_monthly, faq_item_1
  content      String // text/rich text
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  @@index([sectionKey])
  @@map("homepage_content_blocks")
}

// PRD 20: Landing page hero statistics, controllable from the Platform Owner Console.
// valueSource is "auto" (the number is derived from live platform counts) or
// "manual" (the number shown is the value stored in manualValue).
model LandingStat {
  id           String   @id @default(cuid())
  key          String   @unique // e.g. schools_registered, total_students, verification_codes, uptime
  label        String // short descriptor shown under the number, e.g. "schools registered"
  valueSource  String   @default("auto") // auto | manual
  manualValue  String   @default("") // used only when valueSource === "manual"
  enabled      Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("landing_stats")
}

// ---------------------------------------------------------------------------
// Offline Exam Sync (Phase 1) — Hub, OfflineBundle, ExamPin
// ---------------------------------------------------------------------------

enum HubStatus {
  active
  revoked
}

model Hub {
  id                  String    @id @default(cuid())
  schoolId            String
  name                String
  apiKeyHash          String
  signingSecret       String
  invigilatorCodeHash String
  status              HubStatus @default(active)
  lastSeenAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  school   School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bundles  OfflineBundle[]
  attempts ExamAttempt[]

  @@index([schoolId])
  @@map("hubs")
}

model OfflineBundle {
  id        String   @id @default(cuid())
  bundleId  String   @unique
  examId    String
  hubId     String
  schoolId  String
  status    String   @default("pending") // pending | downloaded | closed
  payload   String // encrypted msb1.<iv>.<tag>.<ct>
  issuedAt  DateTime @default(now())
  expiresAt DateTime
  createdAt DateTime @default(now())

  exam   Exam      @relation(fields: [examId], references: [id])
  hub    Hub       @relation(fields: [hubId], references: [id])
  school School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  pins   ExamPin[]

  @@index([hubId])
  @@index([examId])
  @@map("offline_bundles")
}

model ExamPin {
  id        String   @id @default(cuid())
  bundleId  String
  examId    String
  studentId String
  pinHash   String
  createdAt DateTime @default(now())

  bundle OfflineBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([bundleId, studentId])
  @@index([examId])
  @@map("exam_pins")
}

// ---- PRD 21: Blog System (platform-owned marketing content) ----
model Keyword {
  id             String   @id @default(cuid())
  keywordText    String
  type           String   @default("short_tail") // short_tail | long_tail
  searchIntent   String   @default("informational") // informational | commercial | comparison
  targetAudience String   @default("general") // teacher | school_admin | proprietor | parent | general
  status         String   @default("planned") // planned | assigned | published | ranking
  priority       Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posts          BlogPost[]

  @@index([status])
}

model BlogCategory {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts BlogPost[]
}

model BlogPost {
  id                    String   @id @default(cuid())
  title                 String
  subtitle              String?
  slug                  String   @unique
  excerpt               String?
  body                  String   @db.Text // markdown / rich text
  status                String   @default("draft") // draft | pending_review | published | archived
  primaryKeywordId      String?
  secondaryKeywordIds   Json? // string[]
  tags                  Json? // string[]
  categoryId            String?
  metaTitle             String?
  metaDescription       String?
  canonicalUrl          String?
  featuredImageUrl      String?
  featuredImageAltText  String?
  schemaType            String   @default("BlogPosting") // BlogPosting | Article | FAQPage
  source                String   @default("manual") // manual | ai_generated
  author                String?
  publishedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  primaryKeyword        Keyword? @relation(fields: [primaryKeywordId], references: [id])
  category              BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([publishedAt])
}

model AiBlogDraftRequest {
  id                       String   @id @default(cuid())
  keywordId                String?
  topicText                String?
  targetAudience           String?
  requestedBy              String?
  status                   String   @default("pending") // pending | completed | failed
  generatedTitleOptions   Json? // string[]
  generatedSubtitle        String?
  generatedExcerpt         String?
  generatedBody            String? @db.Text
  generatedMetaTitle       String?
  generatedMetaDescription String?
  generatedTags            Json? // string[]
  generatedImagePrompt     String?
  createdAt                DateTime @default(now())

  @@index([status])
}

// ---- PRD 22: Google Analytics (platform-owned config) ----
model AnalyticsConfig {
  id                 String   @id @default(cuid())
  ga4MeasurementId   String?
  consentModeEnabled Boolean  @default(true)
  isActive           Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

model ConversionEventDefinition {
  id              String   @id @default(cuid())
  eventName       String   @unique // e.g. demo_request_submitted
  ga4EventMapping String
  isActive        Boolean  @default(true)
}

enum HomeworkStatus {
  draft
  published
  closed
}

enum HomeworkAttemptStatus {
  in_progress
  submitted
  graded
}

model Homework {
  id            String         @id @default(cuid())
  schoolId      String
  classId       String
  subjectId     String
  termId        String
  title         String
  instructions  String?
  dueDate       DateTime?
  status        HomeworkStatus @default(draft)
  createdBy     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id])
  term      Term             @relation(fields: [termId], references: [id], onDelete: Cascade)
  questions HomeworkQuestion[]
  attempts  HomeworkAttempt[]

  @@index([schoolId])
  @@index([classId, subjectId, termId])
  @@map("homework")
}

model HomeworkQuestion {
  id                String         @id @default(cuid())
  homeworkId        String
  type              QuestionType
  order             Int
  marks             Float          @default(1)
  text              String
  options           Json?          // MCQ: [{ text: String, isCorrect: Boolean }] x4
  rubric            Json?          // Essay: grading guidance
  sourceQuestionId  String?        // provenance when imported from Question bank

  homework Homework         @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  answers  HomeworkAnswer[]

  @@index([homeworkId])
  @@map("homework_questions")
}

model HomeworkAttempt {
  id          String              @id @default(cuid())
  homeworkId  String
  studentId   String
  schoolId    String
  classId     String
  termId      String
  status      HomeworkAttemptStatus @default(in_progress)
  mcqScore    Float     @default(0)
  essayScore  Float?
  totalScore  Float?
  percentage  Float?
  published   Boolean   @default(false)
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  homework Homework        @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers  HomeworkAnswer[]

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([classId])
  @@map("homework_attempts")
}

model HomeworkAnswer {
  id                 String        @id @default(cuid())
  attemptId          String
  homeworkQuestionId String
  type               QuestionType
  response           Json          // MCQ: { selectedIndex: Int | null }; Essay: { text: String }
  autoCorrect        Boolean?
  autoScore          Float         @default(0)
  teacherScore       Float?
  teacherComment     String?
  gradedAt           DateTime?

  attempt        HomeworkAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  homeworkQuestion HomeworkQuestion @relation(fields: [homeworkQuestionId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@map("homework_answers")
}
