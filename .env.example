# Database (Postgres)
DATABASE_URL="postgresql://user:password@host:port/db"

# Auth — generate a random 64-char hex string
AUTH_SECRET="change-me-to-a-random-secret"

# AI Gateway (PRD 14)
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
AI_DEFAULT_MODEL="anthropic/claude-sonnet-4.5"
AI_MOCK="true"

# SMTP (email) — uncomment to enable real email sending
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="noreply@marksheet.dev"

# Canonical public site URL (scheme + host, no trailing slash). Drives sitemap,
# robots.txt Host, OG/canonical URLs and JSON-LD. MUST match the domain users/bots
# actually reach, or crawlers will be sent to a dead domain and nothing gets indexed.
NEXT_PUBLIC_SITE_URL="https://marksheet.top"

# Bare hostname of the primary platform domain (no scheme/port), e.g. marksheet.com
MAIN_DOMAIN=marksheet.top

# Paystack payment (server-side secret key; test or live)
PAYSTACK_SECRET_KEY=""

# Managed school email (Resend SMTP) — used when a school has no own SMTP
RESEND_API_KEY=
MANAGED_EMAIL_DOMAIN=marksheet.top
MANAGED_EMAIL_HOST=smtp.resend.com
MANAGED_EMAIL_PORT=587

# Firebase Cloud Messaging (Android app push) — optional; push silently disabled when unset.
# FCM_PRIVATE_KEY is the service-account key with literal \n escapes, quoted, single line.
# FCM_PROJECT_ID=""
# FCM_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"

# Huawei Push Kit (HMS) — parallel provider for Huawei devices without GMS.
# Optional; silently disabled when unset. Get App ID + App Secret from
# AppGallery Connect → your app → Project settings → OAuth 2.0 client.
# HUAWEI_APP_ID=""
# HUAWEI_APP_SECRET=""
