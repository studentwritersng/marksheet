{
	"appId": "com.marksheet.app",
	"appName": "Marksheet",
	"webDir": "www",
	"allowNavigation": [
		"marksheet.top",
		"www.marksheet.top",
		"*.marksheet.top"
	],
	"server": {
		"url": "https://marksheet.top/login",
		"cleartext": false
	},
	"android": {
		"backgroundColor": "#ffffff",
		"allowMixedContent": true
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
